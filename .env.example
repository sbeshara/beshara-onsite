# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon public" key (or the newer "publishable" key). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (or the newer "secret" key). Server only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=
# The address people use to reach the app, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://onsite.besharabuilders.com
# Resend -> API Keys (Sending access). Used for new-message emails.
RESEND_API_KEY=
# Beshara Reports: JobTread API grant key (reads daily logs and the schedule).
JOBTREAD_GRANT_KEY=
# Beshara Reports: Anthropic API key for drafting weekly reports.
ANTHROPIC_API_KEY=
